{
  "name": "pi-leetcode",
  "version": "0.3.0",
  "description": "LeetCode practice workbench and coaching for Pi Coding Agent",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaybeLL/pi-leetcode.git"
  },
  "homepage": "https://github.com/MaybeLL/pi-leetcode#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "leetcode"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "skills",
    "docs",
    "README.md",
    "NOTICE",
    "vendor"
  ],
  "pi": {
    "extensions": [
      "./extensions/leetcode.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "preview": "tsx scripts/render-preview.ts",
    "prepublishOnly": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22.19.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "got": "14.6.6",
    "turndown": "^7.2.4",
    "zod": "4.3.6"
  }
}
