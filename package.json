{
  "name": "pi-leetcode",
  "version": "0.1.0",
  "description": "LeetCode practice workbench and coaching for Pi Coding Agent",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaybeLL/pi-leetcode.git"
  },
  "keywords": [
    "pi-package",
    "leetcode"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "src",
    "skills",
    "docs",
    "README.md",
    "vendor"
  ],
  "pi": {
    "extensions": [
      "./extensions/leetcode.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "preview": "tsx scripts/render-preview.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22.19.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@maybell/leetcode-client": "file:vendor/maybell-leetcode-client-3.5.2-pi.3.tgz",
    "turndown": "^7.2.4"
  },
  "bundleDependencies": [
    "@maybell/leetcode-client"
  ]
}
